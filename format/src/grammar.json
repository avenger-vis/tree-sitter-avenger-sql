{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "avenger_format",
  "rules": {
    "format": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "text"
          },
          {
            "type": "SYMBOL",
            "name": "escape"
          },
          {
            "type": "SYMBOL",
            "name": "directive"
          }
        ]
      }
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^%]+|%"
        }
      }
    },
    "escape": {
      "type": "STRING",
      "value": "%%"
    },
    "directive": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[-+ #0'_]*([0-9]+|\\*)?(\\.([0-9]+|\\*)?)?(E(\\*|[0-9]+)?[A-Za-z]|O[A-Za-z]|[A-Za-z])"
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}