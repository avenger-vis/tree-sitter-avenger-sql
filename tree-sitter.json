{
  "grammars": [
    {
      "name": "avenger_sql",
      "camelcase": "AvengerSql",
      "scope": "source.avenger-sql",
      "path": ".",
      "file-types": [
        "av.sql",
        "av.sqlm"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^avenger-sql$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "The Tree-sitter grammar of avenger-sql",
    "authors": [
      {
        "name": "Jon Mease"
      }
    ],
    "links": {
      "repository": "https://github.com/avenger-vis/tree-sitter-avenger-sql"
    }
  },
  "bindings": {
    "c": true,
    "rust": true
  }
}
