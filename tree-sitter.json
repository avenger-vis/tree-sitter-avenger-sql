{
  "grammars": [
    {
      "name": "avenger_sql",
      "camelcase": "AvengerSql",
      "scope": "source.avenger-sql",
      "path": ".",
      "file-types": ["av.sql", "av.sqlm"],
      "highlights": ["queries/highlights.scm"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Avenger SQL queries and expressions",
    "authors": [
      { "name": "Jon Mease" }
    ],
    "links": {
      "repository": "https://github.com/avenger-vis/tree-sitter-avenger-sql"
    }
  },
  "bindings": {
    "c": true,
    "rust": true
  }
}
