{
  "name": "@avenger-vis/tree-sitter-avenger-sql",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Avenger SQL queries and expressions",
  "type": "module",
  "main": "grammar.js",
  "exports": {
    ".": "./grammar.js"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:highlights": "node scripts/test_highlights.mjs",
    "check-generated": "sh scripts/check_generated.sh",
    "build:wasm": "tree-sitter build --wasm --output target/tree-sitter-avenger-sql.wasm",
    "measure": "node scripts/measure_parser.mjs",
    "sync-conformance": "node scripts/sync_avenger_conformance.mjs"
  },
  "license": "MIT",
  "author": "Avenger contributors and Derek Stride",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avenger-vis/tree-sitter-avenger-sql.git"
  },
  "keywords": [
    "avenger",
    "parser",
    "sql",
    "tree-sitter"
  ],
  "files": [
    "bindings/c/**",
    "bindings/rust/**",
    "grammar.js",
    "grammar/**",
    "LICENSE",
    "queries/**",
    "README.md",
    "src/**",
    "tree-sitter.json",
    "UPSTREAM.md"
  ],
  "devDependencies": {
    "tree-sitter-cli": "0.26.3"
  }
}
