{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "avenger_datetime",
  "rules": {
    "value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "datetime"
        },
        {
          "type": "SYMBOL",
          "name": "time"
        },
        {
          "type": "SYMBOL",
          "name": "range"
        }
      ]
    },
    "datetime": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "date"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "separator",
                  "content": {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "STRING",
                        "value": " "
                      },
                      {
                        "type": "STRING",
                        "value": "T"
                      },
                      {
                        "type": "STRING",
                        "value": "t"
                      }
                    ]
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "time"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_zone"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "date": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "year",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]{4}"
            },
            "named": true,
            "value": "year"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "month",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]{1,2}"
            },
            "named": true,
            "value": "month"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "day",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]{1,2}"
            },
            "named": true,
            "value": "day"
          }
        }
      ]
    },
    "time": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "hour",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]{1,2}"
            },
            "named": true,
            "value": "hour"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "minute",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]{1,2}"
            },
            "named": true,
            "value": "minute"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "second",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]{1,2}"
            },
            "named": true,
            "value": "second"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "."
                },
                {
                  "type": "FIELD",
                  "name": "fraction",
                  "content": {
                    "type": "ALIAS",
                    "content": {
                      "type": "PATTERN",
                      "value": "[0-9]+"
                    },
                    "named": true,
                    "value": "fraction"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_zone": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": " "
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "offset"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "utc"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": " "
            },
            {
              "type": "SYMBOL",
              "name": "zone_name"
            }
          ]
        }
      ]
    },
    "offset": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "sign",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "+"
              },
              {
                "type": "STRING",
                "value": "-"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "hours",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]{1,2}"
            },
            "named": true,
            "value": "hours"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": ":"
                },
                {
                  "type": "FIELD",
                  "name": "minutes",
                  "content": {
                    "type": "ALIAS",
                    "content": {
                      "type": "PATTERN",
                      "value": "[0-9]{1,2}"
                    },
                    "named": true,
                    "value": "minutes"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "utc": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "Z"
        },
        {
          "type": "STRING",
          "value": "z"
        }
      ]
    },
    "zone_name": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_+\\-]*(\\/[A-Za-z0-9_+\\-]+)*"
    },
    "range": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "SYMBOL",
          "name": "_bound"
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": " "
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_bound"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_bound": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "datetime"
        },
        {
          "type": "SYMBOL",
          "name": "unbounded"
        },
        {
          "type": "SYMBOL",
          "name": "null"
        }
      ]
    },
    "unbounded": {
      "type": "PATTERN",
      "value": "[Uu][Nn][Bb][Oo][Uu][Nn][Dd][Ee][Dd]"
    },
    "null": {
      "type": "PATTERN",
      "value": "[Nn][Uu][Ll][Ll]"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}